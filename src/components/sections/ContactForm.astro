---
import { Image } from 'astro:assets';

import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading, { type Breadcrumb } from './SectionHeading.astro';
import contactImage from '../../assets/images/podcast/podcast-studio-1.webp';
import successIcon from '../../assets/images/contact/success.avif';
import { SITE } from '../../config/site';

/**
 * The inquiry form, shown beside a photograph, with the page heading above it.
 *
 * `action` is the endpoint the form posts to. Leave it unset and the form still
 * validates and confirms locally, which is what the demo does — point it at your
 * own handler (Formspree, a serverless function, your CRM) to receive messages.
 */
interface Props {
  breadcrumb: Breadcrumb[];
  title: string;
  excerpt?: string;
  actions?: { label: string; href: string; variant?: 'dark' | 'light' | 'solid-light' | 'outline-light' }[];
  formTitle?: string;
  action?: string;
  topics?: string[];
}

const {
  breadcrumb,
  title,
  excerpt,
  actions,
  formTitle = 'Start the conversation',
  action,
  topics = ['Sales', 'Investors', 'Feedback', 'Collaboration', 'Sponsorship'],
}: Props = Astro.props;
---

<section class="contact-input-section">
  <!-- Clears the fixed header. -->
  <div class="spacer"></div>

  <div class="global">
    <Container>
      <div class="contact-input-block">
        <div class="contact-text-wrap">
          <SectionHeading as="h1" {breadcrumb} {title} {excerpt} {actions} class="contact-text" />
        </div>

        <div class="contact-input-wrap">
          <div class="contact-image-wrap" data-anim="fade-left">
            <Image
              src={contactImage}
              alt="Podcast Studio Frankfurt"
              class="contact-image"
              widths={[500, 900, 1200]}
              sizes="(max-width: 991px) 100vw, 45vw"
              loading="eager"
            />
          </div>

          <div class="contact-form-wrap" data-anim="fade-right">
            <form class="contact-form" name="kontakt" action="/" method="post" data-netlify="true" data-contact-form novalidate>
              <input type="hidden" name="form-name" value="kontakt" />
              <p class="contact-title">{formTitle}</p>
              <div class="contact-line"></div>

              <div class="contact-wrap is-full">
                <div class="contact-wrapper">
                  <label class="contact-label" for="contact-paket">Paket</label>
                  <input class="contact-field" id="contact-paket" name="paket" type="text" readonly value="Allgemeine Anfrage" />
                </div>
              </div>

              <div class="contact-wrap">
                <div class="contact-wrapper">
                  <label class="contact-label" for="contact-name">Name *</label>
                  <input
                    class="contact-field"
                    id="contact-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    required
                  />
                </div>

                <div class="contact-wrapper">
                  <label class="contact-label" for="contact-email">E-Mail *</label>
                  <input
                    class="contact-field"
                    id="contact-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                  />
                </div>
              </div>

              <div class="contact-wrap is-full">
                <div class="contact-wrapper">
                  <label class="contact-label" for="contact-phone">Telefon *</label>
                  <input
                    class="contact-field"
                    id="contact-phone"
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                    required
                  />
                </div>
              </div>

              <div class="contact-wrap is-full">
                <div class="contact-wrapper">
                  <label class="contact-label" for="contact-message">Nachricht *</label>
                  <textarea
                    class="contact-field is-contact-area"
                    id="contact-message"
                    name="message"
                    rows="8"
                    required></textarea>
                </div>
              </div>

              <div class="contact-button">
                <Button label="Anfrage senden" type="submit" />
              </div>
            </form>

            <div class="contact-success" data-form-success hidden>
              <div class="contact-success-wrap">
                <Image src={successIcon} alt="" class="contact-success-icon" loading="lazy" />
                <p class="contact-success-title">Vielen Dank – Ihre Anfrage ist bei uns eingegangen.</p>
                <p class="contact-message">Wir melden uns in der Regel innerhalb eines Werktages.</p>
              </div>
            </div>

            <div class="contact-error" data-form-error hidden>
              <p class="contact-message">
                Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt an{' '}
                <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </div>
</section>

<script>
  const paket = new URLSearchParams(window.location.search).get('paket');
  if (paket) {
    const input = document.getElementById('contact-paket') as HTMLInputElement;
    if (input) input.value = paket;
  }
</script>
