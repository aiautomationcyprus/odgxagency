---
import Button from '../ui/Button.astro';

/**
 * The about page opener: a headline over a full-bleed photograph, with the
 * fixed header cleared by the spacer above it.
 */
interface Props {
  title: string;
  actions?: { label: string; href: string; variant?: 'dark' | 'light' | 'solid-light' | 'outline-light' }[];
}

const { title, actions = [] } = Astro.props;
---

<section class="banner-section is-about">
  <div class="banner-block is-about">
    <div class="spacer"></div>

    <div class="global">
      <div class="section-gap">
        <div class="about-text-block">
          <div class="about-text">
            <h1 class="about-title" data-anim="hero-title">{title}</h1>

            {
              actions.length > 0 && (
                <div class="about-button" data-anim="fade-up" data-anim-delay="0.4">
                  {actions.map((action) => (
                    <Button label={action.label} href={action.href} variant={action.variant} />
                  ))}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
