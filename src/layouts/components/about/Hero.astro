---
import { markdownify } from "@/lib/utils/textConverter";
import ImageMod from "../ImageMod.astro";

const { hero } = Astro.props;
---

<section class="section pt-16 pb-8">
  <div class="container">
    <div class="row justify-center">
      <div class="col-12 lg:col-10">
        <p
          set:html={markdownify(hero.trust.title)}
          class="text-center mb-8"
          data-aos="fade-up-sm"
        />
        <div
          class="flex flex-wrap justify-center items-center gap-x-8 gap-y-5"
          data-aos="fade-up-sm"
        >
          {
            hero.trust.business.map((item: string) => (
              <ImageMod
                src={item}
                alt="trusted business"
                width={118}
                height={32}
                class="mx-auto grayscale opacity-50"
                format="webp"
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
