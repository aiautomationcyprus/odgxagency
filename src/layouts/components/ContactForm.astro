---
import config from "@/config/config.json";
import { getTranslations } from "@/lib/utils/languageParser";
import type { ContentEntryMap } from "astro:content";

const { lang } = Astro.params;

const { contact_form_action }: { contact_form_action: string } = config.params;

const {
  full_name,
  full_name_placeholder,
  mail,
  mail_placeholder,
  message,
  message_placeholder,
  submit,
} = await getTranslations(lang as keyof ContentEntryMap);
---

<div class="p-10 rounded-xl bg-light h-full">
  <form action={contact_form_action} method="POST">
    <div class="mb-4" data-aos="fade-up-sm">
      <label for="name" class="form-label">{full_name}</label>
      <input
        id="name"
        name="name"
        class="form-input"
        placeholder={full_name_placeholder}
        type="text"
        required
      />
    </div>
    <div class="mb-4" data-aos="fade-up-sm">
      <label for="email" class="form-label">{mail}</label>
      <input
        id="email"
        name="email"
        class="form-input"
        placeholder={mail_placeholder}
        type="email"
        required
      />
    </div>
    <div class="mb-6" data-aos="fade-up-sm">
      <label for="message" class="form-label">{message}</label>
      <textarea
        id="message"
        name="message"
        class="form-input"
        placeholder={message_placeholder}
        rows="5"
        required></textarea>
    </div>
    <button type="submit" class="btn btn-primary w-full" data-aos="fade-up-sm">
      {submit}
    </button>
  </form>
</div>
