---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/sections/ContactForm.astro';
import ContactInfo from '../components/sections/ContactInfo.astro';
import { ROUTES } from '../config/site';
---

<BaseLayout
  title="Contact Us"
  description="Talk to our team about your goals, or ask us anything about how we work."
>
  <ContactForm
    breadcrumb={[{ label: 'Home', href: ROUTES.home }, { label: 'Contact Us' }]}
    title="Let's talk about simplifying your business"
    excerpt="We're here to answer your questions, support your goals, and explore new opportunities."
    actions={[
      { label: 'Start a Business', href: ROUTES.investors },
      { label: 'Get Free Consulting', href: ROUTES.contact, variant: 'light' },
    ]}
  />

  <ContactInfo />
</BaseLayout>
