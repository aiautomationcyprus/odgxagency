    <Container>
      <div class="faq-text-block podcast-gallery-head">
        <SectionHeading
          tag="Beispiele"
          title="So kann Ihr Podcast"
          titleTail="aussehen"
          excerpt="Kundenprojekt Consorsbank: Konzeption, Aufnahme und Schnitt aus einer Hand. Aufgenommen in unserem Frankfurter Studio, mit Video-Setup und professionellem Sound. Fahren Sie mit der Maus über die Clips und sehen Sie, wie Ihr Podcast aussehen kann."
          class="faq-text"
        />
      </div>
      <div class="podcast-gallery">
        {beispiele.map((b, i) => (
          <a
            class="podcast-short-card"
            href={`https://www.youtube.com/shorts/${b.id}`}
            target="_blank"
            rel="noopener"
            aria-label={`${b.title} auf YouTube ansehen`}
            data-short={b.id}
            data-anim="fade-up"
            data-anim-delay={i * 0.1}
          >
            <img
              class="podcast-short-thumb"
              src={`https://i.ytimg.com/vi/${b.id}/maxresdefault.jpg`}
              alt={b.title}
              loading="lazy"
            />
            <span class="podcast-short-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- 3. Intro – Reichweite-Statement (word-reveal) -->
