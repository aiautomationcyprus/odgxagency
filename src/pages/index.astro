    actions={[
      { label: 'Podcast anfragen', href: '/kontakt/', variant: 'outline-light' },
    ]}
  />

  <!-- 2+3 wrapped for mobile reorder -->
  <div class="podcast-reorder-wrap">

  <!-- 2. Beispiele – YouTube Shorts -->
