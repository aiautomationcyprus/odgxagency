</BaseLayout>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.podcast-short-card');
  const canHover = window.matchMedia('(hover: hover)').matches;

  const start = (card: HTMLElement) => {
    if (card.querySelector('iframe')) return;
    const id = card.dataset.short;
    const iframe = document.createElement('iframe');
    iframe.className = 'podcast-short-frame';
    // Browsers only allow sound after a user gesture on the page, otherwise start muted
    const mute = navigator.userActivation?.hasBeenActive ? 0 : 1;
    iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&mute=${mute}&controls=0&loop=1&playlist=${id}&playsinline=1&rel=0&modestbranding=1&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
    iframe.title = card.getAttribute('aria-label') ?? 'Short';
    iframe.tabIndex = -1;
    // Fallback: explicitly ask the player to start once it has loaded
    iframe.addEventListener('load', () => {
      iframe.contentWindow?.postMessage(JSON.stringify({ event: 'command', func: 'playVideo', args: [] }), '*');
    });
    card.appendChild(iframe);
    card.classList.add('is-playing');
  };

  const stop = (card: HTMLElement) => {
    card.querySelector('iframe')?.remove();
    card.classList.remove('is-playing');
  };

  cards.forEach((card) => {
    if (canHover) {
      card.addEventListener('mouseenter', () => start(card));
      card.addEventListener('mouseleave', () => stop(card));
      card.addEventListener('focus', () => start(card));
      card.addEventListener('blur', () => stop(card));
    } else {
      // Touch: first tap plays inline, second tap opens on YouTube
      card.addEventListener('click', (e) => {
        if (!card.classList.contains('is-playing')) {
          e.preventDefault();
          cards.forEach((c) => c !== card && stop(c));
          start(card);
        }
      });
    }
  });
</script>

<style>
  .podcast-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding: 2rem 0 2.5rem;
    max-width: 980px;
    margin: 0 auto;
  }

  /* Intro statement: same whitespace below as above inside the white band */
  .podcast-intro-section :global(.details-text-block) {
    margin-bottom: 0;
  }

  .podcast-gallery-head {
    margin-top: 0;
    margin-bottom: 0;
  }

  .podcast-gallery-head :global(.section-text) {
    padding-top: 3rem;
    padding-bottom: 0;
  }

  .podcast-photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .podcast-photo-item {
    border-radius: var(--radius-xs);
    overflow: hidden;
  }

  .podcast-photo-img {
    width: 100%;
    height: 18rem;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 767px) {
    .podcast-photos {
      grid-template-columns: 1fr;
    }
  }

  .podcast-short-card {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background: #000;
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.12);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .podcast-short-card:hover,
