---
import ContactForm from "@/components/ContactForm.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { supportedLang } from "@/lib/utils/languageParser";
import { markdownify } from "@/lib/utils/textConverter";
import type { ContentEntryMap } from "astro:content";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
}

const { lang } = Astro.params;
const contactIndex = await getListPage(
  "contact",
  lang as keyof ContentEntryMap
);
const { title, meta_title, description, hero } = contactIndex[0].data;
---

<Base title={title} meta_title={meta_title} description={description}>
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="col-12 text-center mb-14">
          <h1
            set:html={markdownify(hero.title)}
            class="mb-6 text-[32px] md:text-[48px] lg:text-[64px]"
            data-aos="fade-up-sm"
          />
          <p
            set:html={markdownify(hero.content)}
            class="lg:w-1/2 mx-auto"
            data-aos="fade-up-sm"
          />
        </div>
        <div class="col-12 md:col-10 lg:col-8">
          <ContactForm lang={lang} />
        </div>
      </div>
    </div>
  </section>
</Base>
