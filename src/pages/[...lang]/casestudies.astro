---
import Base from "@/layouts/Base.astro";
import { supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const isDE = lang !== "en";

const cases = [
  { id: "adelta",      name: "Adelta Finanz" },
  { id: "home-hostel", name: "Home Hostel" },
  { id: "jetsoftware", name: "JetSoftware" },
];
---

<Base
  title={isDE ? "Unsere Cases" : "Our Cases"}
  meta_title={isDE ? "Cases – ODGX Agency" : "Cases – ODGX Agency"}
  description={isDE
    ? "Unternehmen, denen wir Sichtbarkeit verschafft haben – und Wachstum!"
    : "Companies we've helped grow through visibility and smart marketing."}
>

  <!-- Header + Tab Nav -->
  <section class="pt-28 pb-0">
    <div class="container">
      <p class="text-primary font-semibold mb-3 tracking-wide uppercase text-sm">Case Studies</p>
      <h1 class="text-[32px] md:text-[48px] lg:text-[56px] mb-4">
        {isDE ? "Ergebnisse, die für sich sprechen" : "Results that speak for themselves"}
      </h1>
      <p class="text-lg text-text-gray mb-12 max-w-2xl">
        {isDE
          ? "Echte Projekte. Echte Zahlen. So arbeiten wir mit unseren Kunden."
          : "Real projects. Real numbers. This is how we work with our clients."}
      </p>

      <!-- Tab bar -->
      <div class="border-b border-border">
        <div class="flex gap-0 overflow-x-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
          {cases.map((c, i) => (
            <button
              class={`case-tab cursor-pointer px-6 py-4 font-semibold text-sm border-b-2 transition-colors whitespace-nowrap -mb-px ${
                i === 0
                  ? "border-primary text-primary"
                  : "border-transparent text-text/40 hover:text-text hover:cursor-pointer"
              }`}
              data-target={c.id}
            >
              {c.name}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Adelta Finanz AG -->
  <div id="panel-adelta" class="case-panel">
    <section class="pt-16 pb-20">
      <div class="container">

        <div class="rounded-2xl overflow-hidden mb-16 border border-border shadow-xl">
          <img src="/images/cases/adelta-digitalx-case.png" alt="Adelta Finanz AG" class="w-full object-cover max-h-[420px]" />
        </div>

        <div class="mb-14 border-b border-border pb-10 flex items-center gap-6">
          <img src="/images/cases/adelta-logo.png" alt="Adelta Finanz AG" class="h-10 object-contain" />
          <div>
            <h2 class="text-3xl md:text-4xl font-bold mb-2">Adelta Finanz AG</h2>
            <p class="text-lg text-text-gray">B2B LeadGen mit SEA und SEO</p>
          </div>
        </div>

        <div class="row mb-16">
          <div class="col-12 md:col-6 mb-10 md:mb-0 border-r border-border pr-10">
            <p class="text-5xl font-bold text-primary/20 mb-4">01</p>
            <h3 class="text-xl font-bold mb-4">
              {isDE ? "Herausforderung" : "Challenge"}
            </h3>
            <p class="text-text-gray leading-relaxed">
              Der Factoring-Markt ist kein ruhiges Fahrwasser. Er ist hart umkämpft, im ständigen Wandel — und verzeiht keine halbherzige Sichtbarkeit.
            </p>
          </div>
          <div class="col-12 md:col-6 pl-10">
            <p class="text-5xl font-bold text-primary/20 mb-4">02</p>
            <h3 class="text-xl font-bold mb-4">
              {isDE ? "Lösung" : "Solution"}
            </h3>
            <p class="text-text-gray leading-relaxed">
              SEO und Generative Engine Optimization kombiniert: Google und die großen LLMs gleichzeitig abdecken. Dazu gezielte Social Media Paid Kampagnen und organische Posts — für Leads, die wirklich konvertieren.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
          <div class="rounded-2xl overflow-hidden aspect-[9/16] border border-border shadow-xl">
            <img src="/images/cases/adelta-handwerker-digitalx-2.webp" alt="Adelta Handwerker" class="w-full h-full object-cover" />
          </div>
          <div class="rounded-2xl overflow-hidden aspect-[9/16] border border-border shadow-xl">
            <video class="w-full h-full object-cover" autoplay muted loop playsinline>
              <source src="/videos/adelta-reel.mp4" type="video/mp4" />
            </video>
          </div>
          <div class="rounded-2xl overflow-hidden aspect-[9/16] border border-border shadow-xl">
            <img src="/images/cases/adelta-risiko-digitalx-1.webp" alt="Adelta Risiko" class="w-full h-full object-cover" />
          </div>
          <div class="rounded-2xl overflow-hidden aspect-[9/16] border border-border shadow-xl">
            <img src="/images/cases/adelta-digitalx-some-2.webp" alt="Adelta Social Media" class="w-full h-full object-cover" />
          </div>
        </div>

        <div class="border-l-4 border-primary pl-8 py-2 mb-16">
          <h3 class="text-xl font-bold mb-4">
            {isDE ? "Die Herausforderung" : "The Challenge"}
          </h3>
          <p class="text-text-gray leading-relaxed max-w-3xl">
            In einem Markt voller Lautstärke die richtigen Entscheider erreichen. Qualität vor Quantität. Jeden Tag.
          </p>
        </div>

        <div class="rounded-2xl overflow-hidden mb-16 border border-border shadow-xl">
          <img src="/images/cases/adelta-factoring-expertise.webp" alt="Adelta Factoring Expertise" class="w-full object-cover max-h-[420px]" />
        </div>

        <div class="border-t border-border pt-12 text-center">
          <h3 class="text-2xl md:text-3xl font-bold mb-6">
            {isDE ? "Bereit für Ergebnisse wie diese?" : "Ready for results like these?"}
          </h3>
          <a href="/kontakt" class="btn btn-primary mr-4">
            {isDE ? "Kostenfreies Erstgespräch" : "Free initial consultation"}
          </a>
          <p class="mt-4 text-text-gray text-sm">
            {isDE ? "Per Telefon:" : "By phone:"}
            <a href="tel:+4969175361190" class="font-semibold hover:text-primary"> 069 1753 611 90</a>
          </p>
        </div>

      </div>
    </section>
  </div>

  <!-- Home Hostel -->
  <div id="panel-home-hostel" class="case-panel hidden">
    <section class="pt-16 pb-20">
      <div class="container">

        <div class="overflow-hidden mb-16">
          <img src="/images/cases/odgx-usecases-ugc.png" alt="Home Hostel Frankfurt – Social Media & UGC" class="w-full object-cover max-h-[420px]" />
        </div>

        <div class="mb-14 border-b border-border pb-10">
          <h2 class="text-3xl md:text-4xl font-bold mb-2">Home Hostel Frankfurt</h2>
          <p class="text-lg text-text-gray">
            {isDE
              ? "Website, Paid Ads & Social Media für ein neues Hostel mitten in Frankfurt"
              : "Website, Paid Ads & Social Media for a new hostel in the heart of Frankfurt"}
          </p>
        </div>

        <div class="row mb-16">
          <div class="col-12 md:col-6 mb-10 md:mb-0 border-r border-border pr-10">
            <p class="text-5xl font-bold text-primary/20 mb-4">01</p>
            <h3 class="text-xl font-bold mb-4">
              {isDE ? "Herausforderung" : "Challenge"}
            </h3>
            <p class="text-text-gray leading-relaxed">
              {isDE
                ? "Ein neues Hostel in einer Stadt mit vielen Mitbewerbern – ohne bestehende Bekanntheit, ohne Community, ohne Bewertungen. Studenten, Geschäftsreisende und Wochenendbesucher als Zielgruppen gleichzeitig zu erreichen, ohne im Rauschen der Konkurrenz unterzugehen: das war die Aufgabe."
                : "A new hostel in a city crowded with competitors — no existing awareness, no community, no reviews. Reaching students, business travellers and weekend visitors simultaneously without getting lost in the competitive noise: that was the challenge."}
            </p>
          </div>
          <div class="col-12 md:col-6 pl-10">
            <p class="text-5xl font-bold text-primary/20 mb-4">02</p>
            <h3 class="text-xl font-bold mb-4">
              {isDE ? "Lösung" : "Solution"}
            </h3>
            <p class="text-text-gray leading-relaxed">
              {isDE
                ? "Wir haben eine neue Website entwickelt, die die Atmosphäre des Hostels authentisch transportiert. Ergänzt durch zielgruppenspezifische Paid Ads, die je nach Persona unterschiedliche Botschaften ausspielen, und organischen Social-Media-Content, der direkt vor Ort mit dem Team entstanden ist – nah am Gast, nah an der Realität."
                : "We developed a new website that authentically reflects the hostel's atmosphere. Combined with persona-specific paid ads delivering different messages to each audience segment, and organic social media content created on-site with the team — close to guests, close to reality."}
            </p>
          </div>
        </div>

        <div class="border-l-4 border-primary pl-8 py-2 mb-16">
          <h3 class="text-xl font-bold mb-4">
            {isDE ? "Das Ergebnis" : "The Result"}
          </h3>
          <p class="text-text-gray leading-relaxed max-w-3xl">
            {isDE
              ? "Das Hostel erreicht heute konstant hohe Auslastung. Das Design wird aktiv weiterempfohlen, die Positionierung als modernes, faires Übernachtungsangebot ist etabliert. Was als unbekanntes Neuobjekt startete, hat sich zu einer festen Adresse in Frankfurt entwickelt – mit einer Community, die es trägt."
              : "The hostel now consistently achieves high occupancy rates. The design is actively recommended, and its positioning as a modern, fairly priced accommodation has been firmly established. What started as an unknown newcomer has grown into a recognised Frankfurt address — with a community that sustains it."}
          </p>
        </div>

        <div class="border-t border-border pt-12 text-center">
          <h3 class="text-2xl md:text-3xl font-bold mb-6">
            {isDE ? "Bereit für Ergebnisse wie diese?" : "Ready for results like these?"}
          </h3>
          <a href="/kontakt" class="btn btn-primary mr-4">
            {isDE ? "Kostenfreies Erstgespräch" : "Free initial consultation"}
          </a>
          <p class="mt-4 text-text-gray text-sm">
            {isDE ? "Per Telefon:" : "By phone:"}
            <a href="tel:+4969175361190" class="font-semibold hover:text-primary"> 069 1753 611 90</a>
          </p>
        </div>

      </div>
    </section>
  </div>

  <!-- JetSoftware -->
  <div id="panel-jetsoftware" class="case-panel hidden">
    <section class="pt-16 pb-20">
      <div class="container">

        <div class="overflow-hidden mb-16">
          <img src="/images/cases/geo-ai.webp" alt="GEO & AI – JetSoftware" class="w-full object-cover max-h-[420px]" />
        </div>

        <div class="mb-14 border-b border-border pb-10 flex items-center gap-6">
          <img src="/images/cases/jetsoftware-logo.png" alt="JetSoftware" class="h-10 object-contain" />
          <div>
            <h2 class="text-3xl md:text-4xl font-bold mb-2">JetSoftware</h2>
          <p class="text-lg text-text-gray">
            {isDE
              ? "SEO & GEO gegen die großen Player – nachhaltige Sichtbarkeit für ein Softwarehaus"
              : "SEO & GEO against the big players — sustainable visibility for a software company"}
          </p>
          </div>
        </div>

        <div class="row mb-16">
          <div class="col-12 md:col-6 mb-10 md:mb-0 border-r border-border pr-10">
            <p class="text-5xl font-bold text-primary/20 mb-4">01</p>
            <h3 class="text-xl font-bold mb-4">
              {isDE ? "Herausforderung" : "Challenge"}
            </h3>
            <p class="text-text-gray leading-relaxed">
              {isDE
                ? "In der Softwareentwicklung tummeln sich die Schwergewichte: Microsoft, Oracle, Google. Für ein spezialisiertes Softwarehaus wie JetSoftware bedeutet das, mit einem Bruchteil des Budgets gegen Konzerne mit eigenen Marketing-Abteilungen anzutreten – und trotzdem bei relevanten Keywords dauerhaft in den Suchergebnissen und in KI-Ausgaben zu erscheinen."
                : "Software development is dominated by heavyweights: Microsoft, Oracle, Google. For a specialised software company like JetSoftware, that means competing against corporations with dedicated marketing departments on a fraction of the budget — and still appearing consistently in search results and AI outputs for relevant keywords."}
            </p>
          </div>
          <div class="col-12 md:col-6 pl-10">
            <p class="text-5xl font-bold text-primary/20 mb-4">02</p>
            <h3 class="text-xl font-bold mb-4">
              {isDE ? "Lösung" : "Solution"}
            </h3>
            <p class="text-text-gray leading-relaxed">
              {isDE
                ? "Wir haben eine präzise Keyword-Architektur entwickelt, die Suchintention und Wettbewerbsdruck genau analysiert. On-Page-Optimierung, technisches SEO und gezielter Linkaufbau wurden mit Maßnahmen kombiniert, die JetSoftware auch in LLM-Ausgaben wie ChatGPT und Perplexity als relevante Quelle positionieren."
                : "We developed a precise keyword architecture based on exact analysis of search intent and competitive pressure. On-page optimisation, technical SEO and targeted link building were combined with measures that position JetSoftware as a relevant source in LLM outputs like ChatGPT and Perplexity."}
            </p>
          </div>
        </div>

        <div class="border-l-4 border-primary pl-8 py-2 mb-16">
          <h3 class="text-xl font-bold mb-4">
            {isDE ? "Das Ergebnis" : "The Result"}
          </h3>
          <p class="text-text-gray leading-relaxed max-w-3xl">
            {isDE
              ? "JetSoftware platziert sich heute dauerhaft für relevante Keywords in den Google-Suchergebnissen – trotz der Budgetungleichheit gegenüber den großen Wettbewerbern. Die Kombination aus klassischem SEO und gezielter LLM-Sichtbarkeit sorgt für kontinuierlichen, qualifizierten Traffic und Sichtbarkeit genau dort, wo potenzielle Kunden ihre Recherche beginnen."
              : "JetSoftware now holds consistent rankings for relevant keywords in Google search results — despite the budget imbalance against major competitors. The combination of classic SEO and targeted LLM visibility drives continuous, qualified traffic and ensures visibility exactly where potential clients start their research."}
          </p>
        </div>

        <div class="border-t border-border pt-12 text-center">
          <h3 class="text-2xl md:text-3xl font-bold mb-6">
            {isDE ? "Bereit für Ergebnisse wie diese?" : "Ready for results like these?"}
          </h3>
          <a href="/kontakt" class="btn btn-primary mr-4">
            {isDE ? "Kostenfreies Erstgespräch" : "Free initial consultation"}
          </a>
          <p class="mt-4 text-text-gray text-sm">
            {isDE ? "Per Telefon:" : "By phone:"}
            <a href="tel:+4969175361190" class="font-semibold hover:text-primary"> 069 1753 611 90</a>
          </p>
        </div>

      </div>
    </section>
  </div>

</Base>

<script>
  function initCaseTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".case-tab");
    const panels = document.querySelectorAll<HTMLElement>(".case-panel");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.target;

        tabs.forEach((t) => {
          t.classList.remove("border-primary", "text-primary");
          t.classList.add("border-transparent", "text-text/40");
        });
        tab.classList.add("border-primary", "text-primary");
        tab.classList.remove("border-transparent", "text-text/40");

        panels.forEach((p) => p.classList.add("hidden"));
        document.getElementById(`panel-${target}`)?.classList.remove("hidden");
      });
    });
  }

  document.addEventListener("astro:page-load", initCaseTabs);
  document.addEventListener("DOMContentLoaded", initCaseTabs);
</script>
