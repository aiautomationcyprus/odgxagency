---
import Base from "@/layouts/Base.astro";
import { supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const isDE = lang !== "en";

