---
import Base from "@/layouts/Base.astro";
import { supportedLang } from "@/lib/utils/languageParser";
import ContactForm from "@/components/ContactForm.astro";
import DynamicIcon from "@/helpers/DynamicIcon";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({ params: { lang: lang || undefined } }));
}

const { lang } = Astro.params;
const isDE = lang !== "en";

const services = isDE ? [
  { icon: "FaCode", title: "Websites & Relaunch", text: "Vom kompletten Neuaufbau bis zum gezielten Relaunch – individuelle Gestaltung, technisch sauber umgesetzt und von Anfang an für Suchmaschinen optimiert." },
  { icon: "FaCartShopping", title: "Online-Shops", text: "Conversion-optimierte Shops, die verkaufen. Durchdachte Nutzerführung, schnelle Ladezeiten und integriertes SEO – skalierbar mit Ihrem Unternehmen." },
  { icon: "FaArrowsRotate", title: "Baukasten-Migration", text: "Ihre Website läuft noch auf Ionos, Jimdo oder Wix? Wir migrieren Sie zügig auf ein professionelles CMS – inklusive Content-Migration und SEO-Weiterleitungen." },
  { icon: "FaUniversalAccess", title: "BFSG-Konformität", text: "Das Barrierefreiheitsstärkungsgesetz gilt seit 28.06.2025. Wir prüfen Ihre Website und setzen sie auf Wunsch barrierefrei um – damit Sie auf der sicheren Seite sind." },
] : [
  { icon: "FaCode", title: "Websites & Relaunch", text: "From a complete new build to a targeted relaunch – custom design, technically clean implementation and search engine optimised from the start." },
  { icon: "FaCartShopping", title: "Online Shops", text: "Conversion-optimised shops that sell. Thoughtful user flow, fast loading times and integrated SEO – scalable as your business grows." },
  { icon: "FaArrowsRotate", title: "Page Builder Migration", text: "Your website still runs on a page builder? We migrate you quickly to a professional CMS – including content migration and SEO redirects." },
  { icon: "FaUniversalAccess", title: "BFSG Accessibility", text: "The German Accessibility Strengthening Act has applied since 28.06.2025. We audit your site and make it accessible on request – so you're on the safe side." },
];

const steps = isDE ? [
  { num: "01", title: "Analyse & Konzept", text: "Wir prüfen Ihre bestehende Seite, Inhalte und Rankings. Was bleibt, was kommt weg, was wird besser? Sie erhalten einen klaren Fahrplan mit festem Go-Live-Termin." },
  { num: "02", title: "Design & Entwicklung", text: "Individuelles Webdesign oder hochwertig adaptiertes Template – technisch sauber umgesetzt, responsiv auf jedem Gerät und auf Conversion ausgelegt." },
  { num: "03", title: "Go-Live & Übergabe", text: "Vollständige Content-Migration, saubere 301-Weiterleitungen für Ihr Google-Ranking, Einweisung in Ihr CMS – auf Wunsch mit laufendem Support." },
] : [
  { num: "01", title: "Analysis & concept", text: "We review your existing site, content and rankings. What stays, what goes, what improves? You receive a clear roadmap with a fixed go-live date." },
  { num: "02", title: "Design & development", text: "Custom web design or a high-quality adapted template – technically clean, responsive on every device and built for conversion." },
  { num: "03", title: "Go-live & handover", text: "Full content migration, clean 301 redirects to protect your Google rankings, CMS training – with ongoing support on request." },
];

const trust = isDE ? [
  "Ihr Google-Ranking bleibt beim Relaunch erhalten – durch saubere Weiterleitungen und SEO-geprüfte Architektur",
  "Fester Go-Live-Termin nach dem Erstgespräch – kein offenes Ende, kein Scope Creep",
  "Sie können Ihre Website nach der Übergabe selbst pflegen – wir schulen Sie ein",
  "WordPress, Kirby, Typo3 oder AstroJS – wir empfehlen das System, das wirklich zu Ihnen passt",
] : [
  "Your Google ranking is preserved in the relaunch – through clean redirects and SEO-reviewed architecture",
  "Fixed go-live date agreed after the initial call – no open end, no scope creep",
  "You can maintain your website yourself after handover – we train you",
  "WordPress, Kirby, Typo3 or AstroJS – we recommend the system that truly fits you",
];

const faqs = isDE ? [
  { q: "Wie lange dauert die Migration von einem Baukastensystem?", a: "Je nach Umfang und Ihrer Zuarbeit oft nur wenige Wochen – inklusive Content-Migration und SEO-Weiterleitungen. Den genauen Zeitplan klären wir im Erstgespräch." },
  { q: "Bleibt mein Google-Ranking beim Relaunch erhalten?", a: "Ja – durch saubere 301-Weiterleitungen, übernommene Meta-Daten und eine SEO-geprüfte Informationsarchitektur sichern wir Ihre Rankings ab. SEO ist eines unserer Kernarbeitsgebiete." },
  { q: "Welches CMS empfehlen Sie?", a: "Das hängt von Ihren Anforderungen ab. WordPress ist die vielseitigste Lösung für die meisten Unternehmen. Kirby eignet sich für schlanke, schnelle Seiten. Typo3 für große Organisationen mit komplexen Rechteanforderungen. AstroJS für maximale Performance und SEO. Von Baukastensystemen raten wir für professionelle Auftritte grundsätzlich ab." },
  { q: "Ist meine neue Website BFSG-konform?", a: "Auf Wunsch, ja. Wir prüfen im Erstgespräch, ob Ihre Website unter die gesetzliche Pflicht fällt, und kalkulieren den Aufwand transparent mit ein. So vermeiden Sie eine teure Nachrüstung im Nachhinein." },
  { q: "Wie starte ich?", a: "Rufen Sie uns an: 069 1753 611 90 oder füllen Sie das Formular aus. Wir melden uns innerhalb eines Werktages und klären Ihre Anforderungen – Sie erhalten danach ein verbindliches Angebot." },
] : [
  { q: "How long does migration from a page builder take?", a: "Depending on scope and your input, often just a few weeks – including content migration and SEO redirects. We clarify the exact timeline in the initial call." },
  { q: "Will my Google ranking be preserved in the relaunch?", a: "Yes – through clean 301 redirects, carried-over meta data and an SEO-reviewed information architecture we protect your rankings. SEO is one of our core competencies." },
  { q: "Which CMS do you recommend?", a: "It depends on your requirements. WordPress is the most versatile solution for most businesses. Kirby suits lean, fast sites. Typo3 suits large organisations with complex permissions. AstroJS for maximum performance and SEO. We generally advise against page builders for professional presences." },
  { q: "Will my new website be BFSG-compliant?", a: "On request, yes. We check in the initial call whether your website falls under the legal requirement and include the effort transparently in your quote – so you avoid expensive retrofitting later." },
  { q: "How do I get started?", a: "Call us: 069 1753 611 90 or fill in the form. We'll get back to you within one business day, clarify your requirements and send you a binding quote." },
];
---

<Base
  title={isDE ? "Webdesign Agentur Frankfurt – WordPress, Typo3, AstroJS – ODGX Agency" : "Web Design Agency Frankfurt – WordPress, Typo3, AstroJS – ODGX Agency"}
  meta_title={isDE ? "Webdesign Frankfurt – Websites & Online-Shops – ODGX Agency" : "Web Design Frankfurt – Websites & Online Shops – ODGX Agency"}
  description={isDE ? "Professionelles Webdesign aus Frankfurt. WordPress, Kirby, Typo3, AstroJS – individuell gestaltet, suchmaschinenoptimiert, BFSG-konform. Vom Baukasten zur modernen Website." : "Professional web design from Frankfurt. WordPress, Kirby, Typo3, AstroJS – custom built, SEO-optimised, BFSG-compliant. From page builder to modern website."}
>

  <!-- Hero -->
  <div class="relative overflow-hidden">
    <img src="/images/homepage/patternBg.svg" alt="" class="absolute top-0 left-0 -z-10 object-cover w-[168%] h-full pointer-events-none" />
    <div class="absolute w-full lg:w-[71%] aspect-[0.618/1] opacity-20 top-0 right-[14%] -z-10 rotate-[-157deg]">
      <div class="absolute w-[40%] aspect-[0.325/1] bg-[#a5a2ff] rounded-full blur-[200px] left-[138px] top-[31px] rotate-12"></div>
      <div class="absolute w-[40%] aspect-[0.572/1] bg-[#29c775] rounded-full blur-[200px] left-[222px] top-[208px]"></div>
      <div class="absolute w-[40%] aspect-[0.571/1] bg-[#ffe74b] rounded-full blur-[200px] left-[436px] top-[340px]"></div>
    </div>
    <section class="pt-28 pb-16">
      <div class="container text-center md:w-3/4 xl:w-full">
        <p class="text-primary font-semibold mb-3 tracking-wide uppercase text-sm" data-aos="fade-up-sm">
          {isDE ? "Webdesign Agentur aus Frankfurt" : "Web Design Agency from Frankfurt"}
        </p>
        <h1 class="text-[32px] md:text-[48px] lg:text-[64px] mb-6" data-aos="fade-up-sm">
          {isDE ? "Ihre Website kostet Sie täglich Kunden" : "Your website is costing you customers every day"}
        </h1>
        <p class="lg:w-1/2 mx-auto mb-4 text-lg text-text-gray" data-aos="fade-up-sm">
          {isDE
            ? "Eine Website, die langsam lädt, auf dem Smartphone bricht oder bei Google nicht gefunden wird, ist kein Aushängeschild – sie ist ein Umsatzkiller. Wir bringen Ihre Website auf den Stand, den Ihre Kunden erwarten."
            : "A website that loads slowly, breaks on mobile or can't be found on Google is not a showpiece – it's a revenue killer. We bring your website up to the standard your customers expect."}
        </p>
        <p class="lg:w-1/2 mx-auto mb-10 text-lg font-medium" data-aos="fade-up-sm">
          {isDE ? "15+ Jahre Erfahrung – Agentur aus dem Herzen Frankfurts." : "15+ years of experience – agency from the heart of Frankfurt."}
        </p>
        <a href={isDE ? "/kontakt" : "/contact"} class="btn btn-primary" data-aos="fade-up-sm">
          {isDE ? "Kostenlose Website-Analyse anfragen" : "Request a free website analysis"}
        </a>
      </div>
    </section>
  </div>

  <!-- Photos -->
  <section class="pb-0 pt-16">
    <div class="container">
      <div class="row g-4">
        <div class="col-12 md:col-4" data-aos="zoom-in-sm" data-aos-delay="0">
          <img src="/images/webdev/webdev-1.jpg" alt="Webdesign Frankfurt – ODGX Agency" class="rounded-2xl w-full h-72 object-cover" />
        </div>
        <div class="col-12 md:col-4" data-aos="zoom-in-sm" data-aos-delay="100">
          <img src="/images/webdev/webdev-2.png" alt="WordPress Webdesign Frankfurt" class="rounded-2xl w-full h-72 object-cover" />
        </div>
        <div class="col-12 md:col-4" data-aos="zoom-in-sm" data-aos-delay="200">
          <img src="/images/webdev/webdev-3.png" alt="Webentwicklung Projekt Frankfurt" class="rounded-2xl w-full h-72 object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="pb-20 pt-16">
    <div class="container">
      <div class="row g-4 justify-center">
        {services.map((s, i) => (
          <div class="col-12 md:col-6 lg:col-3" data-aos="fade-up-sm" data-aos-delay={i * 100}>
            <div class="bg-light rounded-2xl p-8 h-full">
              <div class="mb-4 p-4 rounded-full bg-body w-fit">
                <DynamicIcon icon={s.icon} className="text-primary text-2xl" />
              </div>
              <h4 class="mb-3">{s.title}</h4>
              <p class="text-text/80">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CMS Section -->
  <section class="section bg-light">
    <div class="container">
      <div class="row justify-center items-center g-4">
        <div class="col-12 lg:col-6" data-aos="fade-up-sm">
          <p class="text-primary font-semibold uppercase text-sm tracking-wide mb-3">
            {isDE ? "Das richtige System für Ihr Projekt" : "The right system for your project"}
          </p>
          <h2 class="mb-6">
            {isDE ? "WordPress, Kirby, Typo3 oder AstroJS – wir empfehlen, was passt" : "WordPress, Kirby, Typo3 or AstroJS – we recommend what fits"}
          </h2>
          <p class="text-text-gray mb-6">
            {isDE
              ? "Viele Agenturen empfehlen immer dasselbe System – unabhängig davon, was Sie wirklich brauchen. Wir wählen das CMS nach Ihren Anforderungen: Für professionelle Auftritte raten wir grundsätzlich von Baukastensystemen ab."
              : "Many agencies always recommend the same system – regardless of what you actually need. We choose the CMS based on your requirements. For professional presences we generally advise against page builders."}
          </p>
          <ul class="space-y-3">
            {(isDE ? [
              "WordPress – vielseitigste Lösung, ideal für Unternehmensseiten und Content-Marketing",
              "Kirby – schlank und schnell, ideal für klar strukturierte Seiten ohne Datenbank-Ballast",
              "Typo3 – Enterprise-Lösung für große Organisationen mit komplexen Rechteanforderungen",
              "AstroJS – maximale Performance und SEO, volle Code-Kontrolle, ideal für statische Seiten",
            ] : [
              "WordPress – most versatile solution, ideal for business sites and content marketing",
              "Kirby – lean and fast, ideal for clearly structured sites without database overhead",
              "Typo3 – enterprise solution for large organisations with complex permission requirements",
              "AstroJS – maximum performance and SEO, full code control, ideal for static sites",
            ]).map((item) => (
              <li class="flex items-start gap-3">
                <DynamicIcon icon="FaCircleCheck" className="text-primary text-xl mt-0.5 shrink-0" />
                <span class="text-text-gray">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="col-12 lg:col-5 lg:col-offset-1" data-aos="zoom-in-sm">
          <div class="bg-body rounded-2xl p-8 text-center">
            <p class="text-6xl font-bold text-primary mb-2">15+</p>
            <p class="text-text-gray mb-8">{isDE ? "Jahre Webdesign-Erfahrung" : "Years of web design experience"}</p>
            <p class="text-4xl font-bold text-primary mb-2">069 1753 611 90</p>
            <p class="text-text-gray">{isDE ? "Direkter Draht zu Ihrem Webentwickler" : "Direct line to your web developer"}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="section">
    <div class="container">
      <h2 class="text-center mb-14" data-aos="fade-up-sm">
        {isDE ? "So arbeiten wir" : "How we work"}
      </h2>
      <div class="row g-4 justify-center">
        {steps.map((s, i) => (
          <div class="col-12 md:col-4" data-aos="fade-up-sm" data-aos-delay={i * 100}>
            <div class="bg-light rounded-2xl p-8 h-full">
              <p class="text-5xl font-bold text-primary/20 mb-4">{s.num}</p>
              <h4 class="mb-3">{s.title}</h4>
              <p class="text-text/80">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why ODGX -->
  <section class="section bg-light">
    <div class="container">
      <div class="row justify-center items-center g-4">
        <div class="col-12 lg:col-5" data-aos="fade-up-sm">
          <h2 class="mb-6">
            {isDE ? "Warum ODGX Agency?" : "Why ODGX Agency?"}
          </h2>
          <p class="text-text-gray mb-8">
            {isDE
              ? "Viele Agenturen bauen Websites. Wir bauen Websites, die verkaufen. Sie arbeiten direkt mit dem Entwickler, der Ihr Projekt kennt – fester Ansprechpartner, klarer Fahrplan, keine Überraschungen."
              : "Many agencies build websites. We build websites that sell. You work directly with the developer who knows your project – one fixed contact, clear roadmap, no surprises."}
          </p>
          <ul class="space-y-4">
            {trust.map((item) => (
              <li class="flex items-start gap-3">
                <DynamicIcon icon="FaCircleCheck" className="text-primary text-xl mt-0.5 shrink-0" />
                <span class="font-medium">{item}</span>
              </li>
            ))}
          </ul>
          <a href={isDE ? "/kontakt" : "/contact"} class="btn btn-primary mt-8 inline-block">
            {isDE ? "Jetzt Erstgespräch buchen" : "Book a free initial call"}
          </a>
        </div>
        <div class="col-12 lg:col-6 lg:col-offset-1" data-aos="zoom-in-sm">
          <div class="bg-body rounded-2xl p-8 text-center">
            <p class="text-6xl font-bold text-primary mb-2">5+</p>
            <p class="text-text-gray mb-8">{isDE ? "Personentage Mindestaufwand – transparent kalkuliert" : "Person-days minimum effort – transparently calculated"}</p>
            <p class="text-4xl font-bold text-primary mb-2">28.06.25</p>
            <p class="text-text-gray">{isDE ? "BFSG in Kraft – wir helfen Ihnen, compliant zu sein" : "BFSG in force – we help you stay compliant"}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container md:w-3/4 lg:w-2/3">
      <h2 class="text-center mb-14" data-aos="fade-up-sm">
        {isDE ? "Häufige Fragen" : "Frequently asked questions"}
      </h2>
      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <details class="bg-light rounded-2xl p-6 group" data-aos="fade-up-sm" data-aos-delay={i * 50}>
            <summary class="font-semibold text-lg cursor-pointer list-none flex justify-between items-center">
              {faq.q}
              <DynamicIcon icon="FaChevronDown" className="text-primary text-sm transition-transform group-open:rotate-180 shrink-0 ml-4" />
            </summary>
            <p class="mt-4 text-text-gray leading-relaxed">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA + Contact -->
  <section class="section">
    <div class="container">
      <div class="row g-4 justify-center">
        <div class="col-12 text-center mb-6">
          <h2 class="text-[32px] md:text-[48px] mb-4" data-aos="fade-up-sm">
            {isDE ? "Bereit für eine Website, die wieder verkauft?" : "Ready for a website that sells again?"}
          </h2>
          <p class="lg:w-1/2 mx-auto text-text-gray" data-aos="fade-up-sm">
            {isDE ? "Im Erstgespräch klären wir Ihre Anforderungen – Sie erhalten danach ein verbindliches Angebot. Keine versteckten Kosten, keine Überraschungen." : "In the initial call we clarify your requirements – you then receive a binding quote. No hidden costs, no surprises."}
          </p>
        </div>
        <div class="col-12 md:col-10 lg:col-8 xl:col-5">
          <div class="p-10 rounded-xl bg-light h-full flex flex-col justify-between">
            <h3 class="mb-6" data-aos="fade-up-sm">
              {isDE ? "Jetzt Kontakt aufnehmen" : "Get in touch"}
            </h3>
            <div>
              {[
                { icon: "FaEnvelope", name: "info@online-digitalx.de" },
                { icon: "FaPhone", name: "069 1753 611 90" },
                { icon: "FaLocationDot", name: isDE ? "Frankfurt am Main" : "Frankfurt am Main, Germany" },
              ].map((c, i) => (
                <div class="flex items-center mb-4 last:mb-0" data-aos="fade-up-sm" data-aos-delay={i * 100}>
                  <div class="mr-4 p-5 rounded-full bg-primary w-fit">
                    <DynamicIcon icon={c.icon} className="text-text-light text-3xl" />
                  </div>
                  <p class="text-xl">{c.name}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="col-12 md:col-10 lg:col-8 xl:col-7">
          <ContactForm lang={lang} />
        </div>
      </div>
    </div>
  </section>

</Base>
