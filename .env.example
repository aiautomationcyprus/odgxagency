# =============================================================================
# Content source
# =============================================================================
# The theme reads its content from local Markdown, MDX and JSON by default, so
# a fresh clone renders the complete demo site with no configuration at all.
#
# To take content from a CMS instead, set CONTENT_SOURCE and the credentials for
# that source. Collections the CMS does not provide keep falling back to the
# local files, so a partial migration still builds.
#
#   local | contentful | sanity | strapi | wordpress | shopify
CONTENT_SOURCE=local

# --- Contentful --------------------------------------------------------------
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_DELIVERY_TOKEN=
# CONTENTFUL_ENVIRONMENT=master
# CONTENTFUL_PREVIEW=false
# CONTENTFUL_PREVIEW_TOKEN=

# --- Sanity ------------------------------------------------------------------
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_VERSION=2024-10-01
# SANITY_TOKEN=

# --- Strapi ------------------------------------------------------------------
# STRAPI_URL=https://cms.example.com
# STRAPI_TOKEN=

# --- WordPress ---------------------------------------------------------------
# Uses the REST API built into every install; no plugin required.
# WORDPRESS_URL=https://blog.example.com
# WORDPRESS_AUTH=            # only for private sites: "Basic ..." or "Bearer ..."

# --- Shopify -----------------------------------------------------------------
# Reads a blog through the Storefront API. Use a Storefront token, never Admin.
# SHOPIFY_STORE=your-store   # the myshopify subdomain
# SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_BLOG_HANDLE=news
# SHOPIFY_API_VERSION=2024-10
